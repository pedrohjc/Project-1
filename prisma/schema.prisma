// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?        // hash bcrypt; null para OAuth
  name          String
  role          String         @default("user")
  provider      String?        // 'google', 'facebook', 'linkedin' ou null (e-mail)
  providerId    String?        // ID do provedor social
  avatarUrl     String?        // Foto do perfil social
  extraTokens   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  subscription Subscription?
  tokenUsages   TokenUsage[]
  tokenTopUps   TokenTopUp[]
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  productId String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  threadId  String?   // ID do thread do OpenAI Assistant

  @@index([userId, productId])
}

model Message {
  id             String       @id @default(cuid())
  role           String       // 'user' ou 'assistant'
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   // 'free', 'monthly', 'yearly'
  status            String   // 'active', 'cancelled', 'expired', 'pending'
  mercadoPagoId     String?  // ID da preferência/pagamento no MercadoPago
  paymentId         String?  // ID do pagamento aprovado
  startDate         DateTime @default(now())
  endDate           DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TokenUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  usedTokens  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodStart])
}

model TokenTopUp {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens        Int
  amount        Float
  status        String   // 'pending', 'approved', 'rejected'
  mercadoPagoId String?
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // 'register' ou 'reset'
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}
